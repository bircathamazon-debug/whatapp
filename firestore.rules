rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public: read approved contacts only
    match /contacts/{contactId} {
      allow read: if resource.data.approved == true;
      allow write: if request.auth != null;
    }

    // Admin only: pending contacts (approved == false)
    match /contacts/{contactId} {
      allow read: if request.auth != null;
    }

    // Categories and zones: public read, admin write
    match /categories/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /zones/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
