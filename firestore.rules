rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Todo lo relacionado con citas contiene datos de clientes (PII) y solo
    // el personal autenticado de la peluquería (app admin) puede leerlo/
    // escribirlo desde el cliente. El bot de WhatsApp y las Cloud Functions
    // usan el SDK de administrador y no pasan por estas reglas.

    match /branches/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /staff/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /services/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /clients/{id} {
      allow read, write: if request.auth != null;
    }

    match /appointments/{id} {
      allow read, write: if request.auth != null;
    }

    match /waitlist/{id} {
      allow read, write: if request.auth != null;
    }

    match /recurringBookings/{id} {
      allow read, write: if request.auth != null;
    }

    match /campaigns/{id} {
      allow read, write: if request.auth != null;
    }

    match /settings/{branchId} {
      allow read, write: if request.auth != null;
    }

    // Cola de notificaciones salientes y estado de conversación del bot:
    // exclusivo del backend (Cloud Functions / bot), nunca desde el cliente.
    match /notifications/{id} {
      allow read, write: if false;
    }

    match /waConversations/{id} {
      allow read, write: if false;
    }
  }
}
