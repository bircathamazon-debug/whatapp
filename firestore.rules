rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Todo lo relacionado con citas contiene datos de clientes (PII) y solo
    // el personal autenticado de la peluquería (app admin) puede leerlo/
    // escribirlo desde el cliente. El bot de WhatsApp y las Cloud Functions
    // usan el SDK de administrador y no pasan por estas reglas.
    //
    // Separación por sucursal/negocio: cada cuenta de login tiene una ficha
    // en "users" que dice a qué sucursal(es) puede entrar (`branchIds`), o
    // si es administrador general (`isSuperAdmin`, ve todas). Sin esa
    // ficha, no ve ninguna. Esto existe para poder prestarle el panel a
    // peluquerías de otros sin que se vean los datos entre ellas.

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isSuperAdmin() {
      return isSignedIn() && userDoc().data.get('isSuperAdmin', false) == true;
    }

    function hasBranchAccess(branchId) {
      return isSignedIn() && (isSuperAdmin() || branchId in userDoc().data.get('branchIds', []));
    }

    // Ninguna cuenta puede escribir su propia ficha de acceso (así nadie
    // puede darse permiso a otra sucursal o a sí mismo): solo se crea con
    // el SDK de administrador, nunca desde el cliente.
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /branches/{id} {
      allow read: if hasBranchAccess(id);
      // Crear o borrar una sucursal (negocio) entera es una acción de alta,
      // reservada al administrador general.
      allow create, delete: if isSuperAdmin();
      // El campo "subscription" (estado real de pago en Stripe) solo lo
      // puede tocar el webhook con el SDK de administrador, que no pasa por
      // estas reglas — así ningún cliente puede marcarse a sí mismo como
      // "activo" sin haber pagado de verdad.
      allow update: if hasBranchAccess(id)
        && request.resource.data.get('subscription', null) == resource.data.get('subscription', null);
    }

    match /staff/{id} {
      allow read: if hasBranchAccess(resource.data.branchId);
      allow create: if hasBranchAccess(request.resource.data.branchId);
      allow update, delete: if hasBranchAccess(resource.data.branchId) && hasBranchAccess(request.resource.data.branchId);
    }

    match /services/{id} {
      allow read: if hasBranchAccess(resource.data.branchId);
      allow create: if hasBranchAccess(request.resource.data.branchId);
      allow update, delete: if hasBranchAccess(resource.data.branchId) && hasBranchAccess(request.resource.data.branchId);
    }

    match /clients/{id} {
      allow read: if hasBranchAccess(resource.data.branchId);
      allow create: if hasBranchAccess(request.resource.data.branchId);
      allow update, delete: if hasBranchAccess(resource.data.branchId) && hasBranchAccess(request.resource.data.branchId);
    }

    match /appointments/{id} {
      allow read: if hasBranchAccess(resource.data.branchId);
      allow create: if hasBranchAccess(request.resource.data.branchId);
      allow update, delete: if hasBranchAccess(resource.data.branchId) && hasBranchAccess(request.resource.data.branchId);
    }

    match /waitlist/{id} {
      allow read: if hasBranchAccess(resource.data.branchId);
      allow create: if hasBranchAccess(request.resource.data.branchId);
      allow update, delete: if hasBranchAccess(resource.data.branchId) && hasBranchAccess(request.resource.data.branchId);
    }

    match /recurringBookings/{id} {
      allow read: if hasBranchAccess(resource.data.branchId);
      allow create: if hasBranchAccess(request.resource.data.branchId);
      allow update, delete: if hasBranchAccess(resource.data.branchId) && hasBranchAccess(request.resource.data.branchId);
    }

    match /blockedTimes/{id} {
      allow read: if hasBranchAccess(resource.data.branchId);
      allow create: if hasBranchAccess(request.resource.data.branchId);
      allow update, delete: if hasBranchAccess(resource.data.branchId) && hasBranchAccess(request.resource.data.branchId);
    }

    match /campaigns/{id} {
      allow read: if hasBranchAccess(resource.data.branchId);
      allow create: if hasBranchAccess(request.resource.data.branchId);
      allow update, delete: if hasBranchAccess(resource.data.branchId) && hasBranchAccess(request.resource.data.branchId);
    }

    match /unansweredMessages/{id} {
      allow read: if hasBranchAccess(resource.data.branchId);
      allow create: if hasBranchAccess(request.resource.data.branchId);
      allow update, delete: if hasBranchAccess(resource.data.branchId) && hasBranchAccess(request.resource.data.branchId);
    }

    match /expenses/{id} {
      allow read: if hasBranchAccess(resource.data.branchId);
      allow create: if hasBranchAccess(request.resource.data.branchId);
      allow update, delete: if hasBranchAccess(resource.data.branchId) && hasBranchAccess(request.resource.data.branchId);
    }

    match /settings/{branchId} {
      allow read, write: if hasBranchAccess(branchId);
    }

    // Cola de notificaciones salientes y estado de conversación del bot:
    // exclusivo del backend (Cloud Functions / bot), nunca desde el cliente.
    match /notifications/{id} {
      allow read, write: if false;
    }

    match /waConversations/{id} {
      allow read, write: if false;
    }

    match /ivrSessions/{id} {
      allow read, write: if false;
    }

    match /systemHealth/{id} {
      allow read, write: if false;
    }

    // Registro de auditoría ("quién cambió qué y cuándo") — de solo lectura
    // desde el panel; solo el SDK de administrador (Cloud Functions) puede
    // escribir acá, así ningún usuario puede borrar ni falsificar su rastro.
    match /auditLog/{id} {
      allow read: if hasBranchAccess(resource.data.branchId);
      allow write: if false;
    }
  }
}
