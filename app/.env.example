EXPO_PUBLIC_FIREBASE_API_KEY=your-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef

# Base URL pública de las Cloud Functions desplegadas (carpeta functions/),
# sin slash final. Se usa para abrir el flujo de conexión de Google Calendar.
# Ej: https://us-central1-tu-proyecto.cloudfunctions.net
EXPO_PUBLIC_FUNCTIONS_BASE_URL=
