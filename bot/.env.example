# Firebase Admin SDK (Firebase Console > Project Settings > Service Accounts)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com

# URL base de las Cloud Functions desplegadas (carpeta functions/), sin slash final.
# Ej: https://us-central1-tu-proyecto.cloudfunctions.net
FUNCTIONS_BASE_URL=

# Debe ser exactamente el mismo valor que BOT_SHARED_SECRET en functions/.env
BOT_SHARED_SECRET=

# Si hay más de una sucursal, cada número de WhatsApp corre su propia
# instancia del bot; indica a qué sucursal (branches/{id} en Firestore)
# pertenece este número.
BRANCH_ID=
