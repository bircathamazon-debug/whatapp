# Imagen del bot para el servicio de prueba de la API oficial
# (RAILWAY_DOCKERFILE_PATH=Dockerfile.cloud). No depende de las herramientas
# de armado de Railway, que a veces fallan al descargarse de GitHub.
FROM node:22-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY . .
CMD ["node", "index.js"]
