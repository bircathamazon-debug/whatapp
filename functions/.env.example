# Secreto compartido entre estas Cloud Functions y el bot de WhatsApp (bot/.env)
# Generar con: openssl rand -hex 32
BOT_SHARED_SECRET=

# Twilio (llamadas telefónicas / SMS para clientes con teléfono kasher)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Base URL pública de las Cloud Functions desplegadas, sin slash final.
# Ej: https://us-central1-tu-proyecto.cloudfunctions.net
TWILIO_IVR_BASE_URL=

# Google Calendar (sincronización opcional por peluquero)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://us-central1-tu-proyecto.cloudfunctions.net/googleCalendarCallback

# Suscripción de pago del sistema (Stripe). Se generan en el Dashboard de
# Stripe: la clave secreta en Developers > API keys, el precio creando un
# producto recurrente en Product catalog (copiar el "API ID" del precio,
# empieza con price_...), y el secreto del webhook al crear el endpoint en
# Developers > Webhooks (apuntando a .../stripeWebhook) — Stripe lo muestra
# una sola vez al crearlo.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Base URL pública de las Cloud Functions desplegadas, sin slash final
# (la misma que FUNCTIONS_BASE_URL/TWILIO_IVR_BASE_URL). Se usa para las
# páginas de "listo" a las que Stripe redirige después de pagar.
FUNCTIONS_BASE_URL=
