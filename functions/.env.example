# Secreto compartido entre estas Cloud Functions y el bot de WhatsApp (bot/.env)
# Generar con: openssl rand -hex 32
BOT_SHARED_SECRET=

# Telnyx (llamadas telefónicas / SMS para clientes con teléfono kasher).
# TELNYX_API_KEY: se genera en el portal de Telnyx (API Keys).
# TELNYX_PHONE_NUMBER: el número comprado, en formato E.164 (ej. +972...).
# TELNYX_CONNECTION_ID: el ID de la "TeXML Application" creada en el portal
# (Voice -> Programmable Voice -> TeXML Applications), con el número
# asignado en su pestaña "Numbers" y el webhook apuntando a
# .../ivrIncomingCall.
# TELNYX_PUBLIC_KEY: Mission Control -> Account Settings -> Public Key
# (distinta de la API key) — sin esto, el sistema no puede verificar que
# una llamada al IVR venga de verdad de Telnyx.
TELNYX_API_KEY=
TELNYX_PHONE_NUMBER=
TELNYX_CONNECTION_ID=
TELNYX_PUBLIC_KEY=

# Google Calendar (sincronización opcional por peluquero)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://us-central1-tu-proyecto.cloudfunctions.net/googleCalendarCallback

# Suscripción de pago del sistema (Stripe). Se generan en el Dashboard de
# Stripe: la clave secreta en Developers > API keys, el precio creando un
# producto recurrente en Product catalog (copiar el "API ID" del precio,
# empieza con price_...), y el secreto del webhook al crear el endpoint en
# Developers > Webhooks (apuntando a .../stripeWebhook) — Stripe lo muestra
# una sola vez al crearlo.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Base URL pública de las Cloud Functions desplegadas, sin slash final.
# Ej: https://us-central1-tu-proyecto.cloudfunctions.net
# Se usa tanto para las páginas de "listo" de Stripe/Tranzila como para el
# <Gather> de las llamadas de recordatorio de Telnyx.
FUNCTIONS_BASE_URL=

# Suscripción de pago del sistema para sucursales en hebreo (Tranzila, ya
# que Stripe no está disponible en Israel). Se generan al crear la cuenta
# en tranzila.com: TRANZILA_TERMINAL_NAME es el nombre del terminal (te lo
# dan al abrir la cuenta), TRANZILA_PASSWORD es la "contraseña de
# transacciones" que se configura en el panel del terminal (distinta de tu
# contraseña de acceso), y TRANZILA_SUBSCRIPTION_SUM es el precio mensual
# en shéquels (ej. 129, sin símbolo de moneda).
TRANZILA_TERMINAL_NAME=
TRANZILA_PASSWORD=
TRANZILA_SUBSCRIPTION_SUM=
