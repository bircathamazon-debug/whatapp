# Secreto compartido entre estas Cloud Functions y el bot de WhatsApp (bot/.env)
# Generar con: openssl rand -hex 32
BOT_SHARED_SECRET=

# Twilio (llamadas telefónicas / SMS para clientes con teléfono kasher)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Base URL pública de las Cloud Functions desplegadas, sin slash final.
# Ej: https://us-central1-tu-proyecto.cloudfunctions.net
TWILIO_IVR_BASE_URL=

# Google Calendar (sincronización opcional por peluquero)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://us-central1-tu-proyecto.cloudfunctions.net/googleCalendarCallback
